<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider 可对外暴露的路径白名单（仅供自更新使用）。

  只映射 `cacheDir/updates/` 一个子目录：系统安装器拿到的是
  content://<applicationId>.fileprovider/update_cache/<文件名>，
  其余私有文件仍然完全不可见。
-->
<paths>
    <cache-path name="update_cache" path="updates/" />
    <external-cache-path name="update_external_cache" path="updates/" />
</paths>
