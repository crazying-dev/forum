# ===== 妖精论坛 v2 后端环境变量模板 =====
# 复制为 .env 后按需修改

# 运行环境（dev=开发 / prod=生产）
APP_ENV=dev
HOST=127.0.0.1
PORT=8090

# Session 密钥（生产必须改为强随机值！）
SECRET_KEY=change-me-to-a-strong-random-secret

# ===== 数据库 =====
# 开发: 本机 Docker PGSQL    生产: 替换为外部 PGSQL 连接串（用户提供）
DATABASE_URL=postgresql://postgres:localdev123@127.0.0.1:5432/yj_forum
# 生产建议 false：由一次性迁移 job 执行，避免多实例并发迁移
MIGRATE_ON_START=true

# ===== SMTP 邮件（开发也需要真实凭据）=====
SMTP_ENABLED=true
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=maomi@email.yjlt.top
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM_NAME=妖精论坛(二创)
RECEIVERALL=maomi@email.yjlt.top

# ===== CORS（空=允许全部；生产建议配置域名）=====
CORS_ORIGINS=

# ===== 存储 =====
AVATAR_DIR=/var/yj-forum/avatar
DATA_DIR=/var/yj-forum/data
# 用户上传媒体（发帖图片）目录；需可写，默认 /var/yj-forum/media
MEDIA_DIR=/var/yj-forum/media

# ===== 业务 =====
IMAGE_FATHER_URL=https://img.crazying-dev.top/text/one
# 站点对外地址（用于邮件链接；无协议时自动补 https，localhost 补 http）
# 本地开发建议：http://localhost:3200
PUBLIC_BASE_URL=yjlt.top
# 可选：覆盖随二进制内置的彩蛋 JSON（默认使用内置数据，无需配置文件）
# EASTER_EGG_PATH=/var/yj-forum/data/easter-egg.json

# ===== SeaweedFS S3（新媒体）=====
S3_ENABLED=false
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=yj-forum
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true
# 上传时预生成 w480/w1280 变体（仅 S3 模式生效；默认 true）
MEDIA_VARIANTS_ENABLED=true

# ===== ALTCHA v2 =====
ALTCHA_ENABLED=false
ALTCHA_HMAC_KEY=
ALTCHA_ALGORITHM=PBKDF2/SHA-256
ALTCHA_COST=5000
ALTCHA_EXPIRES_SECONDS=600

# ===== 旧 APP 兼容层 =====
LEGACY_TOKEN_TTL_HOURS=168
LEGACY_TOKEN_NOT_BEFORE=
LEGACY_APP_SUNSET=

# ===== 下载页 GitHub Releases =====
GITHUB_TOKEN=
