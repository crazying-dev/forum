<view class="page-root {{night ? 'night' : ''}} {{national ? 'national' : ''}}">
  <view class="container auth">
    <view class="brand">注册账号</view>
    <view class="brand-sub">需邮箱验证码完成注册</view>

    <view class="field">
      <view class="field-label">用户名（2-20 字符）</view>
      <input class="input" value="{{name}}" maxlength="20" placeholder="设置你的用户名" bindinput="onName" />
    </view>

    <view class="field">
      <view class="field-label">邮箱</view>
      <input class="input" value="{{email}}" placeholder="用于验证与找回密码" bindinput="onEmail" />
    </view>

    <view class="field">
      <view class="field-label">邮箱验证码</view>
      <view class="code-row">
        <input class="input code-input" value="{{code}}" maxlength="6" type="number"
               placeholder="6 位数字" bindinput="onCode" />
        <view class="code-btn {{countdown > 0 || sending ? 'code-btn-off' : ''}}" bindtap="onSendCode">
          {{countdown > 0 ? countdown + 's' : (sending ? '发送中' : '获取验证码')}}
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">密码（≥8 位，含字母与数字）</view>
      <input class="input" value="{{password}}" password placeholder="设置密码" bindinput="onPwd" />
    </view>

    <view class="btn btn-primary" bindtap="onSubmit">{{submitting ? '注册中…' : '注册'}}</view>

    <view class="links">
      <text bindtap="onLogin">已有账号？去登录</text>
    </view>
  </view>

  <captcha id="captcha"></captcha>
</view>
