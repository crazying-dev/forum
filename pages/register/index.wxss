.auth {
  padding: 60rpx 48rpx;
}

.brand {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--c-primary);
  text-align: center;
}

.brand-sub {
  margin: 16rpx 0 48rpx;
  font-size: 26rpx;
  color: var(--c-text-3);
  text-align: center;
}

.code-row {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
}

.code-btn {
  margin-left: 16rpx;
  padding: 0 26rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: var(--c-primary);
  background: var(--c-icon);
  flex-shrink: 0;
}

.code-btn-off {
  opacity: 0.55;
}

.links {
  margin-top: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--c-primary);
}
