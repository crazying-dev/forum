.cats {
  position: sticky;
  top: 0;
  z-index: 10;
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: var(--c-bg);
  border-bottom: 1rpx solid var(--c-border);
}

.cat {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--c-text-2);
  background: var(--c-icon);
}

.cat-on {
  background: var(--c-primary);
  color: var(--c-on-primary);
  font-weight: 600;
}

.list {
  padding: 24rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 56rpx;
  color: var(--c-on-primary);
  background: var(--c-primary);
  box-shadow: 0 8rpx 28rpx var(--c-shadow);
}
