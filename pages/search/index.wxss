.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--c-bg);
  border-bottom: 1rpx solid var(--c-border);
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: var(--c-input);
  border: 2rpx solid var(--c-border);
  font-size: 28rpx;
  color: var(--c-text);
}

.search-btn {
  margin-left: 16rpx;
  padding: 0 32rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: var(--c-primary);
  color: var(--c-on-primary);
  font-size: 28rpx;
  flex-shrink: 0;
}

.result {
  padding: 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: var(--c-text-3);
  margin: 8rpx 0 16rpx;
}

.user-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: 18rpx;
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
}

.u-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.u-avatar-ph {
  background: linear-gradient(135deg, #84A8B9, #6A8C89);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.u-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.u-name {
  font-size: 30rpx;
  color: var(--c-text);
}

.u-intro {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--c-text-3);
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
