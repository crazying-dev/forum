# ============================================================
# Host A（ouo + SeaweedFS）—— /etc/wireguard/wg0.conf
# 安装：install -m 0600 wg0-host-a.conf.example /etc/wireguard/wg0.conf
# 启动：systemctl enable --now wg-quick@wg0
# 注意：替换所有 <...> 占位符；本文件不得提交真实私钥。
# ============================================================
[Interface]
Address = 10.8.0.1/24
ListenPort = 51820
PrivateKey = <HOST_A_PRIVATE_KEY>
# 隧道 MTU（遇到大包超时可显式指定）
MTU = 1420

[Peer]
# Host B（admin）
PublicKey = <HOST_B_PUBLIC_KEY>
# 只允许到 Host B 的 /32，不做全局路由
AllowedIPs = 10.8.0.2/32
# 保持 NAT 映射（双向都配也无害）
PersistentKeepalive = 25

# 可选：若 Host B 有固定公网地址，可加 Endpoint = <HOST_B_PUBLIC_IP>:51820
# 若 Host B 在 NAT 后，保持不配 Endpoint，由 B 主动发起。
