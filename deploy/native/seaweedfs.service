# ============================================================
# SeaweedFS 4.x 单机服务（master + volume + filer + S3 gateway）
#
# 安装：由 deploy/native/install-weed.sh --apply 写入
#       /etc/systemd/system/seaweedfs.service
# 依赖：WireGuard Host A（wg0 = 10.8.0.1）；公网不开放 8333/9327
# 数据：/var/lib/seaweedfs/data
# 配置：/etc/seaweedfs/s3.json
# ============================================================
[Unit]
Description=SeaweedFS S3 (single-node: master+volume+filer+s3)
Documentation=https://github.com/seaweedfs/seaweedfs
# 公网直连方案：S3 只绑 127.0.0.1，由 Nginx 做 TLS 终止与 IP 白名单；不依赖 WireGuard。
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=seaweedfs
Group=seaweedfs
UMask=0027

# 只绑定本机回环：S3=127.0.0.1:8333，指标=127.0.0.1:9327（公网不可见，由 Nginx 反代）
# 容量：512MB/卷 × 20 = 10GB 上限（宿主机仅 39G 盘、21G 可用；不要照搬默认 30G 卷）
# 内存：宿主机 2GB，Go 软限 + cgroup 硬限双保险
Environment=GOMEMLIMIT=640MiB
ExecStart=/usr/local/bin/weed server -s3 -s3.port=8333 -s3.config=/etc/seaweedfs/s3.json -dir=/var/lib/seaweedfs/data -ip.bind=127.0.0.1 -master.volumeSizeLimitMB=512 -volume.max=20 -metrics.port=9327

Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536

# 资源与加固
MemoryMax=768M
CPUQuota=200%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/seaweedfs

[Install]
WantedBy=multi-user.target
