# ============================================================
# yj-ops 邮件配置模板
# 安装：install -m 0600 deploy/ops/mail.env.example /etc/yj-ops/mail.env
#       然后填入真实 SMTP 信息（本文件不得提交真实密码）。
# notify-mail.sh 用 curl 的 SMTP 能力发送，无需本地 MTA。
# ============================================================

# SMTP 服务器与端口
SMTP_HOST=smtp.example.com
SMTP_PORT=465

# 认证（留空则匿名发送，公网 SMTP 一般不允许）
SMTP_USER=alerts@example.com
SMTP_PASS=<CHANGE_ME_SMTP_PASSWORD>

# implicit（465，默认）/ starttls（587）/ none
SMTP_TLS=implicit

# 发件人（可带显示名；MAIL_FROM_ADDR 可显式指定裸地址）
MAIL_FROM="YJ Forum Ops <alerts@example.com>"
# MAIL_FROM_ADDR=alerts@example.com

# 收件人（多个用逗号分隔）
MAIL_TO=admin@example.com

# 同一主题的最小发送间隔（秒，默认 1800）；0 表示不限流
# NOTIFY_MIN_INTERVAL=1800
